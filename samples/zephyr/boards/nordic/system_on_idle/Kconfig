mainmenu "nRF7120 System ON idle measurement"

config NRF7120_RAM_128K_ONLY
	bool "Keep only the first 128 KiB of RAM powered, power down the rest"
	select RAM_POWER_DOWN_LIBRARY
	select NRF_FORCE_RAM_ON_REBOOT
	help
	  Requests power-down for everything in application RAM above a
	  fixed first 128 KiB (POWERED_RAM_SIZE in src/main.c). The 128 KiB
	  boundary itself is a compile-time constant, not a separate
	  Kconfig value. Enabling this single option is enough: it selects
	  RAM_POWER_DOWN_LIBRARY (the library that performs the power-down)
	  and NRF_FORCE_RAM_ON_REBOOT (which powers all RAM back on before
	  a reboot, so a reflash always starts from a known-good state).

config NRF7120_IDLE_DIAGNOSTICS
	bool "Print System ON idle register snapshots"
	depends on SOC_NRF7120 && SERIAL
	help
	  Print POWER, REGULATORS, HVBUCK, MEMCONF, GRTC, oscillator, and
	  top-level CLOCK state before and after each timed idle interval.
	  These snapshots are taken while the CPU and UART are active; they
	  describe persistent configuration and events, not instantaneous
	  register values during WFI.

config NRF7120_HVBUCK_EVENT_CLEAR
	bool "Clear HVBUCK mode-change events before each idle window"
	depends on NRF7120_IDLE_DIAGNOSTICS
	help
	  Write zero to HVBUCK EVENTS_LP2HP, EVENTS_HP2LP, EVENTS_HP2PWM, and
	  EVENTS_PWM2HP before each timed idle window, then print the
	  immediate post-clear readback. This is the only write this sample
	  makes to the buck converter's own peripheral state, so it is
	  opt-in and default-off: building and flashing the diagnostics
	  variant without this option enabled never writes to HVBUCK.
	  Enabling it is what revealed that EVENTS_HP2LP and EVENTS_LP2HP
	  both fire on every single idle cycle, proving a real HP->LP->HP
	  transition attempt that STATUS and an oscilloscope are both too
	  slow to catch directly.

config NRF7120_FORCE_LOWPWR
	bool "Request variable-latency low-power mode"
	depends on SOC_NRF7120
	help
	  Trigger POWER.TASKS_LOWPWR before entering timed or permanent idle.
	  In this mode oscillators and regulators may stop when no remaining
	  consumer requests their clock or power resources. Hardware A/B
	  testing found no measurable difference with or without this
	  option; it is kept because it is a real, one-shot hardware
	  request worth trying, not because it is known to matter.

config NRF7120_PDSELECT_DIAGNOSTICS
	bool "Route one internal power-state signal to P0.10"
	depends on SOC_NRF7120
	help
	  Write SREGS30.PDSELECT.PIN1 to route the selected internal signal to
	  P0.10. PIN0/P0.09 is kept disabled because P0.09 supplies the board
	  Wi-Fi antenna switch and was not usable as a general monitor.

config NRF7120_PDSELECT_SIGNAL
	int "P0.10 PDSELECT signal"
	depends on NRF7120_PDSELECT_DIAGNOSTICS
	range 0 13
	default 4
	help
	  Select the signal routed through PDSELECT.PIN1 to P0.10:
	  0 disabled, 1 PD_MAIN, 2 PD_LP, 3 PD_PERIPH, 4 PD_MCU,
	  5 PD_RADIO, 6 PD_CRACEN/PD_MCU_AUX, 7 PD_WIFI,
	  8 PwrAboveElv, 9 HVBUCK 1.1 V acknowledge,
	  10 HVBUCK 1.0 V acknowledge, 11 HVBUCK LP mode,
	  12 HVBUCK PWM mode, 13 helper-LDO acknowledge.

config NRF7120_IDLE_PHASE_MARKER
	bool "Track System ON run/idle on P0.00"
	depends on SOC_NRF7120 && SERIAL && GPIO
	help
	  Drive P0.00 high whenever the CPU is not idling (from just after
	  main() starts, and again immediately after every k_sleep/WFI
	  returns) and low, then disconnected, immediately before every
	  k_sleep/WFI call. This directly tracks System ON run versus System
	  ON idle and WFI entry/exit; the pin is disconnected while idling so
	  an active GPIO output cannot itself hold a power domain on. Because
	  it goes high right at the start of the timed loop, a rising edge
	  shortly after power-up also proves the application booted.

config NRF7120_SLEEP_FOREVER
	bool "Block the main thread forever"
	depends on SOC_NRF7120 && !SERIAL
	help
	  Call k_sleep(K_FOREVER) after all requested configuration. This
	  retains the normal Zephyr scheduler and idle-thread path but adds no
	  periodic application timeout. Use for quiet, stable current
	  measurements (combine with configs/quiet.conf).

config NRF7120_WIFI_AUTOCGCORE_CLEAR
	bool "Apply the WZN-9779 Wi-Fi clock workaround"
	depends on SOC_NRF7120
	help
	  Clear WIFICORECLOCKRESETCTRL.CLOCKGATECTRLAUTOCG1.AUTOCGCORE before
	  idle. WZN-9779 identifies this bit as a source of a prolonged Wi-Fi
	  core-clock request after debugger disconnect. This is an engineering
	  diagnostic workaround, not a production integration decision.

source "Kconfig.zephyr"
